@page "/photos"
@using project1.Pages
@inject HttpClient http
<h3>Photospage</h3>

<div class="container">
    <div class="row">
        @if (photos == null || photos.Count == 0)
        {
            <p>Loading...</p>
        }
        else
        {
            @foreach (var photo in photos)
            {
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">

                        <img src="@photo.thumbNailUrl" class="card-img-top" alt="photo" />

                        <div class="card-body">
                            <p class="card-text small">
                                @photo.title
                            </p>
                        </div>

                        <div class="card-footer text-muted d-flex justify-content-between">
                            <span>A:@photo.albumId</span>
                            <span>ID:@photo.id</span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    public List<Photos> photos { get; set; } = new List<Photos>();

    protected override async Task OnInitializedAsync()
    {
        photos = await http.GetFromJsonAsync<List<Photos>>("Photos");
    }

}



