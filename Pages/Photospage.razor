@page "/photos"
@using project1.Pages
@inject HttpClient http
<h3>Photospage</h3>

<div class="table">
    <table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Album Id</th>
            <th>Id</th>
            <th>Title</th>
            <th>Url</th>
            <th>Thumbnail Url</th>
        </tr>
    </thead>
    <tbody>
        @if (photos == null || photos.Count == 0)
        {
            <tr>
                <td colspan="3">Loading...</td>
            </tr>
        }
        else
        {
            @foreach (var photo in photos)
            {
                <tr>
                    <td>@photo.albumId</td>
                    <td>@photo.id</td>
                    <td>@photo.title</td>
                    <td>@photo.url</td>
                    <td>@photo.thumbNailUrl</td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@code {
    public List<Photos> photos { get; set; } = new List<Photos>();

    protected override async Task OnInitializedAsync()
    {
        photos = await http.GetFromJsonAsync<List<Photos>>("Photos");
    }

}



