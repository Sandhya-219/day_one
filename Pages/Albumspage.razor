@page "/albums"
@using project1.Pages
@inject HttpClient http

<h3>Albumspage</h3>

<div class="container">
    <div class="row">
        @if (albums == null || albums.Count == 0)
        {
            <p>Loading...</p>
        }
        else
        {
            @foreach (var album in albums)
            {
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">

                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:150px;">
                            Album
                        </div>
                                                
                        <div class="card-body">
                            <h6 class="card-title">@album.title</h6>
                        </div>
                                               
                        <div class="card-footer text-muted d-flex justify-content-between">
                            <span>User: @album.userId</span>
                            <span>ID: @album.id</span>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>
@code {
    public List<Albums> albums { get; set; } = new List<Albums>();

    protected override async Task OnInitializedAsync()
    {
        albums = await http.GetFromJsonAsync<List<Albums>>("Albums");
    }
}
